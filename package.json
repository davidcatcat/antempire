{
  "name": "antempire",
  "private": true,
  "version": "0.0.0",
  "description": "螞蟻帝國：熱帶大頭家蟻生態模擬（engine 純模擬核心 / cli 推進與檢查工具 / web 預留）",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p engine/tsconfig.json",
    "test": "node tests/run-all.ts",
    "test:golden": "node tests/golden.test.ts",
    "test:naturalism": "node tests/naturalism.test.ts",
    "test:rest": "node tests/run-all.ts --except golden,naturalism",
    "check:saves": "node cli/check-saves.ts",
    "advance": "node cli/advance.ts",
    "evaluate:day0": "node cli/reports/day0-evaluation.ts",
    "evaluate:day0-extremes": "node cli/reports/day0-extremes.ts"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
