{
  "name": "antempire",
  "private": true,
  "version": "0.0.0",
  "description": "螞蟻帝國：熱帶大頭家蟻生態模擬（engine 純模擬核心 / cli 推進與檢查工具 / web 預留）",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p engine/tsconfig.json && tsc -p web/tsconfig.json --noEmit && tsc -p prototypes/art-preview/tsconfig.json --noEmit && tsc -p prototypes/render-harness/tsconfig.json --noEmit && tsc -p prototypes/natural-walk/tsconfig.json --noEmit && tsc -p prototypes/continuous-world/worker/tsconfig.json --noEmit",
    "test": "node tests/run-all.ts",
    "test:golden": "node tests/golden.test.ts",
    "test:naturalism": "node tests/naturalism.test.ts",
    "test:rest": "node tests/run-all.ts --except golden,naturalism",
    "check:saves": "node cli/check-saves.ts",
    "advance": "node cli/advance.ts",
    "evaluate:day0": "node cli/reports/day0-evaluation.ts",
    "evaluate:day0-extremes": "node cli/reports/day0-extremes.ts",
    "web:export": "node cli/web-export.ts",
    "web:build": "tsc -p web/tsconfig.json && tsc -p prototypes/continuous-world/worker/tsconfig.json",
    "web": "npm run web:build && node cli/web-serve.ts",
    "evaluate:phase2-sensitivity": "node cli/reports/phase2-sensitivity.ts --run 4",
    "check:phase2-sensitivity": "node cli/reports/phase2-sensitivity.ts --validate",
    "art:preview": "tsc -p prototypes/art-preview/tsconfig.json && node prototypes/art-preview/shoot.cjs",
    "natural:placeholder": "node prototypes/natural-walk/make-placeholder.ts",
    "natural:shoot": "tsc -p prototypes/natural-walk/tsconfig.json && npm run web:build && node prototypes/natural-walk/shoot.cjs",
    "render:bench": "tsc -p prototypes/render-harness/tsconfig.json && node prototypes/render-harness/bench.cjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
