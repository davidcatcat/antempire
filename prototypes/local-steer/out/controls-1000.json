{
 "schema": "antempire.wp4-controls.v1",
 "label": "隔離物理實驗・對照情境（遊戲假設，非本種）・非正式",
 "node": "v22.23.4",
 "params": {
  "inflow_rate_per_arm_per_s": {
   "value": 2,
   "assumption": true,
   "basis": "遊戲假設",
   "why": "每個方向每秒進場 2 隻（四個方向共 8 隻/s）。大頭家蟻的蟻道流量沒有本種資料；只用於讓密度隨時間建立。"
  },
  "entry_gap_mm": {
   "value": 50,
   "assumption": true,
   "basis": "遊戲假設",
   "why": "入口在交叉點前 50 mm（身體中心再退半個體長），橫向位置沿用格狀基準的同一欄位（k mod 欄數），只改變時間。"
  },
  "exit_capacity": {
   "value": 2,
   "assumption": true,
   "basis": "遊戲假設",
   "why": "每個目標端（通道×方向）的出口同時最多容納 2 隻。"
  },
  "exit_dwell_s": {
   "value": 1,
   "assumption": true,
   "basis": "遊戲假設",
   "why": "每隻進入出口後占用 1 s 才離開出口區。出口最大通量＝容量/停留＝2 隻/s，與流入率相同（刻意讓出口接近飽和而非無限）。"
  },
  "horizon_s": {
   "value": {
    "100": 30,
    "1000": 140
   },
   "assumption": true,
   "basis": "遊戲假設（量測窗）",
   "why": "100 隻：流入最後一隻在約 12.5 s 進場，加上約 5 s 行程與餘裕。1000 隻：最後一隻約 125 s 進場。"
  }
 },
 "variants": {
  "K0_lattice_stay": {
   "inflow": false,
   "exit": false,
   "why": "密集基準本身（格狀起點、抵達者留在路上），時間終點延長到與其他對照相同，作為對照的參照。"
  },
  "K1_lattice_exit": {
   "inflow": false,
   "exit": true,
   "why": "(i) 有限容量出口：抵達者離開道路進入出口；出口滿了就在目標處等（仍是障礙物）。"
  },
  "K2_inflow_stay": {
   "inflow": true,
   "exit": false,
   "why": "(ii) 依時間流入：個體在入口依時間表進場（入口被占就在路外等），不是一開始就排成密集格狀；抵達者留在路上。"
  },
  "K3_inflow_exit": {
   "inflow": true,
   "exit": true,
   "why": "(i)+(ii) 同時。"
  }
 },
 "note": "CPU 是單次量測（機器同時有其他工作，只看數量級）；抵達只是一欄，不是選擇標準；沒有調參；N 沒有亂數抽取，各種子結果相同（測試確認），只跑種子 1",
