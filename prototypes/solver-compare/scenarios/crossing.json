{
  "schema": "antempire.solver-compare.scenario.v1",
  "id": "crossing",
  "title": "兩條通路交叉：同時抵達交叉點",
  "synthetic": true,
  "units": {
    "length": "mm",
    "time": "s",
    "speed": "mm/s"
  },
  "refs": {
    "geometry": "scenarios/physics/crossing.geometry.json",
    "body": "scenarios/physics/pheidole-megacephala.body-candidates.json",
    "interaction": "scenarios/physics/pheidole-megacephala.interaction-candidates.json",
    "motion": "scenarios/physics/pheidole-megacephala.motion-candidates.json"
  },
  "body": {
    "length": {
      "file": "body",
      "path": "castes.minor.body_length_mm.value",
      "why": "小工蟻體長約 2.5 mm（R94，文獻支持）"
    },
    "width": {
      "file": "body",
      "path": "castes.minor.effective_collision_width_mm.candidate_range.1",
      "why": "value 為 null；取候選範圍上限 0.8 mm（與 tests/ph2-collision.test.ts 的 wHi 相同），只作敏感度，非量測"
    },
    "contact_reach": {
      "file": "interaction",
      "path": "contact_reach_mm.candidate_range",
      "op": "midpoint",
      "why": "value 為 null；取候選範圍中點 1.0 mm（與 tests/ph2-collision.test.ts 相同），只作敏感度，非量測"
    }
  },
  "encounter": {
    "priority": {
      "file": "interaction",
      "path": "encounter.priority.value",
      "why": "檔案預設"
    },
    "entry_yield_probability": {
      "file": "interaction",
      "path": "encounter.entry_yield_probability.value",
      "why": "非本種 Lasius niger 202/211（R380）"
    },
    "laden_yield_probability": {
      "file": "interaction",
      "path": "encounter.laden_yield_probability.value",
      "why": "非本種 Atta colombica（R381）；本情境無負載，不會用到"
    },
    "contact_pause_s": {
      "file": "interaction",
      "path": "encounter.contact_pause_s.value",
      "nullable": true,
      "why": "檔案值 null＝不停頓"
    },
    "inside_turn_back_probability": {
      "file": "interaction",
      "path": "encounter.inside_turn_back_probability.candidate_values.1",
      "why": "檔案 value 為 null；取候選值 0.5（與 tests/ph2-collision.test.ts 相同，遊戲假設）。若改為 null，原生模型會回報 unresolved"
    }
  },
  "agents": [
    {
      "id": "E",
      "passage": "P-east-west",
      "s_mm": 200,
      "u_mm": 0,
      "dir": 1,
      "start_t_s": 0,
      "goal_s_mm": 300,
      "speed": {
        "file": "motion",
        "path": "trail_speed_mm_s.pooled.value",
        "why": "合併 17.0 mm/s（R133，文獻支持）"
      }
    },
    {
      "id": "N",
      "passage": "P-north-south",
      "s_mm": 200,
      "u_mm": 0,
      "dir": 1,
      "start_t_s": 0,
      "goal_s_mm": 300,
      "speed": {
        "file": "motion",
        "path": "trail_speed_mm_s.pooled.value",
        "why": "合併 17.0 mm/s（R133，文獻支持）"
      }
    }
  ],
  "horizon_s": 10,
  "seed": 1,
  "rapier": {
    "dt_s": 0.008333333333333333,
    "ccd": false
  },
  "provenance": {
    "scenario_values": "起點、橫向偏移、出發時間、時間長度與種子都是合成情境值（遊戲假設），不是量測，也不是臺中西屯花園。",
    "note": "兩隻同速、與交叉點等距（50 mm），同時抵達（對應 tests/ph2-collision.test.ts §8 的『同時』情況，起點較近、速度改用文獻值 17.0 mm/s）。"
  }
}
