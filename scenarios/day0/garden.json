{
  "schema": "antempire.day0-garden.v1",
  "world_id": "xitun-garden",
  "note": "Day0 的花園生態初始狀態（世界，不是蟻群）。數值沿用世界檔中同一份『花園盤點』遊戲假設（原本放在 day15_migration 下，描述的是花園本身而不是 Day14 蟻群），在此逐項標明出處；**不繼承 Day1～14 的任何蟻群紀錄**（沒有舊屍體批次、沒有 Day14 存糧、沒有個體路線）。寄主植物是否存在依各次評估的世界種子抽樣（與蟻群無關）。屍體與蜜露的初始存量由蟻群建立前的生態暖機自然產生。",
  "warmup_days": {
    "value": 30,
    "assumption": true,
    "basis": "遊戲假設",
    "description": "蟻群建立前，花園生態單獨運行的天數（天氣、寄主、半翅目、昆蟲出生死亡與自然屍體）。暖機期間的自然事件全部記錄。",
    "basis_note": "讓初始存量與天氣記憶由世界過程產生，而不是直接指定；30 日是遊戲假設，不是文獻值。"
  },
  "initial_climate": {
    "soil_index": {
      "value": 0.3,
      "assumption": true,
      "basis": "遊戲假設",
      "description": "暖機開始時的土壤濕度指標（0～1）；經 30 日天氣後只剩很小影響"
    },
    "shade_index": {
      "value": 0.25,
      "assumption": true,
      "basis": "遊戲假設",
